# Copy to .env and fill in. .env is gitignored.

# --- Telegram (forwarding account) -----------------------------------------
# Get TG_API_ID and TG_API_HASH from https://my.telegram.org → API development tools.
# These belong to YOUR Telegram app, not to a specific account.
TG_API_ID=
TG_API_HASH=

# Session string for the *forwarding* account (separate from your main account).
# Generate once via:  pnpm tg:login   then paste the printed string here.
# Treat this as a credential — leaking it grants access to the account.
TG_SESSION_STRING=

# Base64-encoded 32 random bytes used to encrypt the Telegram session at rest
# when you sign in via the Settings page. Without this, the in-app sign-in is
# disabled — env-based TG_SESSION_STRING still works as a fallback. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TG_SESSION_ENCRYPTION_KEY=

# --- Web auth ---------------------------------------------------------------
# Single shared password the web UI accepts on login. Stays as a backup login
# even when the Telegram bot below is configured.
WEB_PASSWORD=
# Secret used to sign the session cookie. Long random string.
SESSION_SECRET=

# --- Telegram Web App bot (optional) ----------------------------------------
# Lets you open the web client directly inside a Telegram bot (as a Mini App)
# and sign the admin in by their Telegram account. The password above remains
# as a fallback. Leave these blank to disable the bot entirely.
#
# Bot token from @BotFather (talk to it, /newbot, copy the token).
TG_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to sign in / command the bot.
# Find yours by messaging @userinfobot. Example: TG_BOT_ADMIN_IDS=12345678,87654321
TG_BOT_ADMIN_IDS=
# Public HTTPS URL the web client is reachable at (Telegram requires HTTPS for
# Mini Apps). The bot sets its menu button + /start button to open this URL.
# Example: PUBLIC_URL=https://tg-feed.example.com
PUBLIC_URL=

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
DATABASE_PATH=./data/tg-feed.sqlite
